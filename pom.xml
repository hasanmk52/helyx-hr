<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.helyx</groupId>
	<artifactId>helyxhr</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Helyx HR</name>
	<description>Multi-tenant HRIS and Leave Management SaaS.</description>
	<url>https://helyx.app</url>
	<licenses>
		<license>
			<name>Proprietary</name>
			<comments>All rights reserved. Not for redistribution.</comments>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Hasan Kagalwala</name>
			<email>hasanmk52@gmail.com</email>
			<organization>MHZ Software</organization>
		</developer>
	</developers>
	<properties>
		<!-- The Spring Boot parent derives maven.compiler.release from java.version. Setting
		     only source/target (as this pom previously did) does NOT work: the compiler plugin
		     honours `release` over `source`/`target`, so the build was silently targeting the
		     parent's default of 17 while CLAUDE.md §3 and CI both said 25. Keep this property
		     as the single source of truth. -->
		<java.version>25</java.version>

		<!-- WebJars versions (bump here, referenced in dependencies below) -->
		<webjars-locator-lite.version>1.1.3</webjars-locator-lite.version>
		<bootstrap.version>5.3.8</bootstrap.version>
		<bootstrap-icons.version>1.13.1</bootstrap-icons.version>
		<htmx.version>2.0.10</htmx.version>
		<alpinejs.version>3.15.12</alpinejs.version>

		<!-- Application dependency versions (CLAUDE.md §7: one place per dependency) -->
		<bucket4j.version>8.14.0</bucket4j.version>
		<greenmail.version>2.1.3</greenmail.version>
		<tika.version>3.2.3</tika.version>

		<!-- Quality gate plugin/dependency versions (CLAUDE.md §7: one place per dependency) -->
		<archunit.version>1.3.2</archunit.version>
		<playwright.version>1.62.0</playwright.version>
		<jacoco.version>0.8.13</jacoco.version>
		<spotbugs-plugin.version>4.9.3.0</spotbugs-plugin.version>
		<pmd-plugin.version>3.28.0</pmd-plugin.version>
		<dependency-check.version>12.1.3</dependency-check.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.thymeleaf.extras</groupId>
			<artifactId>thymeleaf-extras-springsecurity6</artifactId>
		</dependency>

		<!-- WebJars: server-side assets pulled in as Maven dependencies.
		     webjars-locator-lite lets Thymeleaf/URLs reference assets without
		     the version segment (/webjars/bootstrap/css/bootstrap.min.css),
		     so upgrades don't require touching every template.
		     Versions declared in <properties> above. -->
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>webjars-locator-lite</artifactId>
			<version>${webjars-locator-lite.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars</groupId>
			<artifactId>bootstrap</artifactId>
			<version>${bootstrap.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>bootstrap-icons</artifactId>
			<version>${bootstrap-icons.version}</version>
		</dependency>
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>htmx.org</artifactId>
			<version>${htmx.version}</version>
		</dependency>
		<!-- CSP build (@alpinejs/csp), not the default `alpinejs` artifact: SecurityConfig's CSP
		     has no 'unsafe-eval', which the default build needs for expression evaluation. This
		     build parses expressions without eval/new Function instead. -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>alpinejs__csp</artifactId>
			<version>${alpinejs.version}</version>
		</dependency>

		<!-- Tenant lookup cache in TenantResolutionFilter (CLAUDE.md §3 stack: Caffeine,
		     no Redis). Version managed by the Spring Boot BOM. Used directly as a
		     Cache bean - no spring-cache abstraction needed for a single cache. -->
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- Rate limiting: login 10/min/IP, password reset 3/hour/email (PRD §19.7).
		     The _jdk17 variant is the current core artifact and has zero transitive
		     dependencies - verified against its POM before adding (ADR 0006). -->
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j_jdk17-core</artifactId>
			<version>${bucket4j.version}</version>
		</dependency>

		<!-- File-upload magic-byte/MIME sniffing (CLAUDE.md §6 A03), first user is the Holidays
		     CSV bulk upload (Phase 1.5). tika-core only, not tika-parsers: detection only, no
		     document parsing needed. -->
		<dependency>
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>${tika.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- E2E browser automation (CLAUDE.md §3 locked stack). First real use is Phase 1.4
		     (docs/CURRENT_PHASE.md): "the first phase with enough screens to justify the
		     harness" — deferred twice already in 1.2/1.3. Browsers are not on the classpath;
		     they install separately (see the playwright-install exec-maven-plugin execution
		     below), same as any other Playwright-Java setup. -->
		<dependency>
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>playwright</artifactId>
			<version>${playwright.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- In-JVM SMTP server proving the full email_outbox -> SMTP -> inbox path
		     (CLAUDE.md §6a). Deliberately the core artifact, not greenmail-junit5:
		     that one pulls log4j-core + log4j-slf4j-impl, which would collide with
		     Boot's logback on the test classpath. junit:junit is excluded because
		     GreenMail declares JUnit 4 at compile scope and we are JUnit 5 only. -->
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail</artifactId>
			<version>${greenmail.version}</version>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>junit</groupId>
					<artifactId>junit</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Coverage report on verify. Threshold is declared (see jacoco.line.coverage
			     below) but not enforced yet - CLAUDE.md Phase 0 scope: don't fail the
			     first PR on 0% coverage. Enforcement (jacoco:check) lands in a later phase. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<!-- Target line coverage per module, CLAUDE.md §8. Not enforced in Phase 0. -->
					<rules>
						<rule>
							<element>BUNDLE</element>
							<limits>
								<limit>
									<counter>LINE</counter>
									<value>COVEREDRATIO</value>
									<minimum>0.70</minimum>
								</limit>
							</limits>
						</rule>
					</rules>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Report-only in Phase 0, CLAUDE.md §7/§8 says this starts blocking merges
			     from Phase 1 onwards. Not bound to the verify lifecycle yet: spotbugs-maven-plugin
			     4.9.3.0's bundled ASM cannot parse Java 25 class files (major version 69) -
			     it hard-crashes the forked analysis JVM rather than reporting violations, so
			     failOnError=false doesn't help. Run manually with `mvn spotbugs:spotbugs` to
			     see it fail the same way; re-bind the execution below once a compatible
			     release ships. -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>${spotbugs-plugin.version}</version>
				<configuration>
					<failOnError>false</failOnError>
				</configuration>
			</plugin>

			<!-- Report-only in Phase 0 (failOnViolation=false), same as SpotBugs above. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-pmd-plugin</artifactId>
				<version>${pmd-plugin.version}</version>
				<configuration>
					<failOnViolation>false</failOnViolation>
				</configuration>
				<executions>
					<execution>
						<id>pmd-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Not bound to the default lifecycle - it's slow (CVE database download).
			     Invoked explicitly in CI as `mvn org.owasp:dependency-check-maven:check`,
			     fail-soft in Phase 0 via a very high CVSS threshold. -->
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>${dependency-check.version}</version>
				<configuration>
					<failBuildOnCVSS>11</failBuildOnCVSS>
					<formats>
						<format>HTML</format>
					</formats>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
